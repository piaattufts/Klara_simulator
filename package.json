{
  "name": "klara-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Inspectable companion-robot simulator with twenty-five fiction-derived scene cards.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 47231 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 47231 --strictPort",
    "test": "node --test tests/*.test.js",
    "reproduce": "node scripts/reproduce.mjs",
    "export:traces": "node scripts/export-traces.mjs",
    "validate:scenarios": "node scripts/validate-scenarios.mjs",
    "verify:annotations": "node scripts/verify-annotations.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
